# Aethersy AI - Environment Variables
# Backend: FastAPI + Motor (MongoDB) + Telegram Bot

# ===========================================
# DATABASE (MongoDB)
# ===========================================
MONGO_URL=mongodb://localhost:27017
DB_NAME=aethersy_ai

# ===========================================
# TELEGRAM BOT
# ===========================================
TELEGRAM_BOT_TOKEN=bot-token-here
TELEGRAM_ADMIN_ID=123456789

# ===========================================
# AI PROVIDERS - OpenAI
# ===========================================
OPENAI_API_KEY=sk-your-openai-api-key-here

# Default model bindings
DEFAULT_CHAT_PROVIDER=openai
DEFAULT_CHAT_MODEL=gpt-4o
FAST_MODEL_PROVIDER=openai
FAST_MODEL_MODEL=gpt-4o-mini

# Optional: Groq for faster/cheaper completions
GROQ_API_KEY=gsk_xxx

# ===========================================
# AUTH (JWT)
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALG=HS256
JWT_EXP_DAYS=7

# ===========================================
# PAYMENTS (Stripe)
# ===========================================
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID_PRO=price_xxx
STRIPE_PRICE_ID_BUSINESS=price_xxx

# ===========================================
# EMAIL (Resend)
# ===========================================
RESEND_API_KEY=re_xxx
RESEND_FROM=onboarding@resend.dev
RESEND_REPLY_TO=support@aethersy.com

# ===========================================
# CORS & APP URLS
# ===========================================
CORS_ORIGINS=https://aethersy.com,http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ===========================================
# COPILOT (Terminal Agent)
# ===========================================
COPILOT_ENABLED=true
COPILOT_SANDBOX_DIR=/tmp/copilot
